{
	"$schema": "https://schema.railpack.com",
	"steps": {
		"install": {
			"commands": ["bun install"]
		},
		"build": {
			"inputs": [{ "step": "install" }],
			"commands": ["bun --bun run build"]
		},
		"migrate": {
			"inputs": [{ "step": "install" }],
			"commands": ["bun --bun run db:migrate"]
		}
	},
	"deploy": {
		"inputs": [{ "step": "migrate" }, { "step": "build" }],
		"startCommand": "bun run start"
	}
}
